+"""LLM sağlayıcı istemcileri. Anahtar YALNIZCA ortam değişkeninden okunur; koda/repoya yazılmaz.
+
+Ortam değişkenleri:
+  LLM_PROVIDER = anthropic | openai | none   (boş bırakılırsa LLM kullanılmaz, şablon devrede)
+  LLM_MODEL    = model adı (sağlayıcının belgesinden)
+  LLM_API_KEY  = API anahtarı
+  LLM_BASE_URL = (yalnız openai) OpenAI uyumlu uç nokta; Groq, Gemini'nin OpenAI uyumlu ucu,
+                 yerel Ollama (http://localhost:11434/v1) gibi servisler de bu yolla bağlanır.
+Streamlit'te bunlar st.secrets'tan os.environ'a aktarılabilir.
+"""
+from __future__ import annotations
+
+import os
+from typing import Protocol
+
+import requests
+
+TIMEOUT_S = 60
+
+
+class LLMClient(Protocol):
+    def complete(self, system: str, user: str) -> str: ...
+
+
+class AnthropicClient:
+    """Anthropic Messages API."""
+
+    def __init__(self, model: str, api_key: str):
+        self.model, self.api_key = model, api_key
+
+    def complete(self, system: str, user: str) -> str:
+        r = requests.post(
+            "https://api.anthropic.com/v1/messages",
+            headers={"x-api-key": self.api_key, "anthropic-version": "2023-06-01",
+                     "content-type": "application/json"},
+            json={"model": self.model, "max_tokens": 1200, "system": system,
+                  "messages": [{"role": "user", "content": user}]},
+            timeout=TIMEOUT_S)
+        r.raise_for_status()
+        return "".join(b.get("text", "") for b in r.json()["content"])
+
+
+class OpenAICompatClient:
+    """OpenAI Chat Completions biçimindeki herhangi bir servis."""
+
+    def __init__(self, model: str, api_key: str, base_url: str):
+        self.model, self.api_key, self.base_url = model, api_key, base_url.rstrip("/")
+
+    def complete(self, system: str, user: str) -> str:
+        r = requests.post(
+            f"{self.base_url}/chat/completions",
+            headers={"Authorization": f"Bearer {self.api_key}"},
+            json={"model": self.model, "temperature": 0.2,
+                  "messages": [{"role": "system", "content": system},
+                               {"role": "user", "content": user}]},
+            timeout=TIMEOUT_S)
+        r.raise_for_status()
+        return r.json()["choices"][0]["message"]["content"]
+
+
+def get_client() -> LLMClient | None:
+    """Ortam değişkenlerinden istemci kurar; ayar yoksa None (şablon açıklayıcı çalışır)."""
+    provider = os.environ.get("LLM_PROVIDER", "none").strip().lower()
+    if provider in ("", "none"):
+        return None
+    model, key = os.environ.get("LLM_MODEL"), os.environ.get("LLM_API_KEY")
+    if not model or not key:
+        raise RuntimeError("LLM_MODEL ve LLM_API_KEY ortam değişkenleri gerekli.")
+    if provider == "anthropic":
+        return AnthropicClient(model, key)
+    if provider == "openai":
+        return OpenAICompatClient(model, key, os.environ.get("LLM_BASE_URL", "https://api.openai.com/v1"))
+    raise RuntimeError(f"Bilinmeyen LLM_PROVIDER: {provider}")
diff --git a/llm/explain.py b/llm/explain.py
new file mode 100644
index 0000000..c8714ca
--- /dev/null
+++ b/llm/explain.py
@@ -0,0 +1,121 @@
+"""Sonuç (results.json) -> sade dilde açıklama + kanıt tablosu.
+
+LLM yalnızca anlatır: sayıları sonuçtan kopyalar, her iddiaya [ref:id] ekler. LLM yoksa ya da
+doğrulamayı geçemezse `template_explanation` aynı kanıtlardan güvenli bir metin üretir.
+"""
+from __future__ import annotations
+
+import json
+
+from .kb import KnowledgeBase
+
+LABELS = {
+    "uyumlu": "beklenen yönle/hipotezle uyumlu",
+    "celiskili": "beklenenle çelişiyor; başka bir etken baskın olabilir",
+    "yetersiz": "veri kesin bir sonuç için yetersiz",
+}
+
+EXPLAIN_SYSTEM = """Sen bir NASA veri dedektifisin. Lise öğrencisinin anlayacağı sade bir Türkçeyle,
+aşağıdaki analiz sonuçlarını açıkla. KURALLAR (çiğnersen cevabın reddedilir):
+1. Sayıları YALNIZCA sonuç JSON'undan kopyala; hesap yapma, yuvarlarken en fazla 2 ondalık kullan.
+   Yeni sayı (yüzde, fark, toplam) türetme.
+2. Sayı içeren her cümlenin sonuna kaynağı olan analizi [ref:<id>] biçiminde ekle (noktadan önce).
+3. Etiketleri (uyumlu / celiskili / yetersiz) değiştirme; ne anlama geldiklerini sade dille söyle.
+4. Neden kısmında bunun bir İLİŞKİ ya da TUTARLILIK kanıtı olduğunu, kesin neden olmadığını belirt.
+5. Şu dört başlıkla, toplam 120-200 kelime yaz: **Ne değişti?**, **Nerede?**, **Neden olabilir?**,
+   **Ne kadar güvenebiliriz?** Sonuçta olmayan bir başlık için "Bu analizde bu bilgi yok." yaz.
+6. Mann-Kendall p-değerini "bu değişimin tesadüf olma olasılığı" gibi sade bir dille anlat.
+"""
+
+
+def _var_title(kb: KnowledgeBase, name: str | None) -> str:
+    return kb.variables.get(name, {}).get("baslik", name or "?")
+
+
+def _fmt(x, d=2) -> str:
+    return f"{x:.{d}f}"
+
+
+def _fmt_p(p) -> str:
+    return "< 0.001" if p < 0.001 else f"= {p:.3g}"
+
+
+def evidence_table(results: dict, kb: KnowledgeBase) -> list[dict]:
+    """Arayüz için kanıt tablosu satırları (her satırın id'si açıklamadaki [ref:id] ile eşleşir)."""
+    rows = []
+    for a in results.get("analyses", []):
+        rows.append({
+            "id": a.get("id"),
+            "analiz": a.get("type"),
+            "degisken": _var_title(kb, a.get("variable")) if a.get("variable") else a.get("axis", "-"),
+            "urun": a.get("product", "-"),
+            "deger": a.get("sen_slope_per_decade", a.get("observed_shift_m_per_decade")),
+            "birim": (a.get("units", "") + "/on yıl") if "sen_slope_per_decade" in a else
+                     ("m/on yıl" if "observed_shift_m_per_decade" in a else a.get("units", "")),
+            "aralik_95": a.get("ci95"),
+            "p": a.get("mk_p"),
+            "etiket": a.get("label"),
+            "etiket_sade": LABELS.get(a.get("label"), ""),
+        })
+    return rows
+
+
+def _sentence(a: dict, kb: KnowledgeBase) -> str | None:
+    """Tek bir analiz için güvenli (sonuçtan kopyalanmış sayılarla) cümle."""
+    rid, label = a.get("id"), a.get("label")
+    lab = LABELS.get(label, label or "")
+    if a.get("type") == "trend" and a.get("sen_slope_per_decade") is not None:
+        s = (f"{_var_title(kb, a.get('variable'))} ({a.get('product', '?')}) on yılda "
+             f"{_fmt(a['sen_slope_per_decade'])} {a.get('units', '')} değişiyor")
+        if a.get("ci95"):
+            s += f" (%95 güven aralığı {_fmt(a['ci95'][0])} ile {_fmt(a['ci95'][1])})"
+        if a.get("mk_p") is not None:
+            s += f"; Mann-Kendall p {_fmt_p(a['mk_p'])}"
+        if a.get("fdr_fraction_significant") is not None:
+            s += f"; bölgedeki hücrelerin %{a['fdr_fraction_significant'] * 100:.0f}'inde anlamlı"
+        return s + f" [ref:{rid}]. Sonuç: {lab}."
+    if a.get("type") == "boundary_shift" and a.get("observed_shift_m_per_decade"):
+        o, p = a["observed_shift_m_per_decade"], a.get("predicted_shift_m_per_decade")
+        s = (f"{a.get('axis', 'eksen')} boyunca gözlenen sınır kayması on yılda "
+             f"{_fmt(o[0], 0)} ile {_fmt(o[1], 0)} m")
+        if p:
+            s += f", ısınmadan beklenen ise {_fmt(p[0], 0)} ile {_fmt(p[1], 0)} m"
+        return s + f" [ref:{rid}]. Sonuç: {lab}."
+    if label:
+        return f"{a.get('type', 'analiz')} sonucu: {lab} [ref:{rid}]."
+    return None
+
+
+def template_explanation(plan: dict, results: dict, kb: KnowledgeBase) -> str:
+    """LLM'siz yedek açıklama. Yalnızca sonuçtaki sayıları kullanır, her cümle kanıta bağlıdır."""
+    lines = [f"**{plan.get('card_title', 'Analiz')}** — {plan.get('region_name') or results.get('region', {}).get('name', '')}"]
+    if plan.get("sade_tanim"):
+        lines.append(plan["sade_tanim"])
+    for a in results.get("analyses", []):
+        s = _sentence(a, kb)
+        if s:
+            lines.append("- " + s)
+    if plan.get("supheliler"):
+        lines.append("Not: Şüpheli değişkenlerle görülen ilişkiler kesin neden değil, tutarlılık kanıtıdır.")
+    return "\n".join(lines)
+
+
+def llm_explanation(question: str, plan: dict, results: dict, kb: KnowledgeBase, client,
+                    feedback: str | None = None) -> str:
+    """LLM ile açıklama üretir (doğrulama answer.py'de yapılır)."""
+    names = {a.get("variable") for a in results.get("analyses", [])} | \
+            {b["degisken"] for b in plan.get("belirti", [])} | {s["degisken"] for s in plan.get("supheliler", [])}
+    var_cards = {n: {k: kb.variables[n].get(k) for k in ("baslik", "birim", "sade_tanim", "dikkat")}
+                 for n in names if n in kb.variables}
+    context = {
+        "soru": question,
+        "bolge": plan.get("region_name"),
+        "surec": {k: plan.get(k) for k in ("card_title", "sade_tanim", "supheliler", "alternatifler")},
+        "degisken_kartlari": var_cards,
+        "etiket_anlamlari": LABELS,
+        "sonuclar": {k: v for k, v in results.items() if not str(k).startswith("_")},
+    }
+    user = "Analiz bağlamı ve sonuçları (JSON):\n" + json.dumps(context, ensure_ascii=False, indent=1)
+    if feedback:
+        user += "\n\nÖNCEKİ CEVABIN REDDEDİLDİ. Düzelt:\n" + feedback
+    return client.complete(EXPLAIN_SYSTEM, user)
diff --git a/llm/kb.py b/llm/kb.py
new file mode 100644
index 0000000..2d312c6
--- /dev/null
+++ b/llm/kb.py
@@ -0,0 +1,136 @@
+"""Bilgi tabanı (kb/) okuyucusu: süreç kartları, değişken kartları ve yer kartları.
+
+Kartlar YAML'dır ve küçük (onlarca) olduğu için vektör veritabanı gerekmez: LLM'e kart
+listesinin özeti verilir, yedek eşleştirme ise anahtar kelimeyle yapılır.
+"""
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass, field
+from pathlib import Path
+
+import yaml
+
+KB_DIR = Path(__file__).resolve().parent.parent / "kb"
+
+
+def tr_lower(text: str) -> str:
+    """Türkçe'ye uygun küçük harf: 'İ'->'i', 'I'->'ı' (Python'un lower()'ı bunu yanlış yapar)."""
+    return text.replace("İ", "i").replace("I", "ı").lower()
+
+
+def _starts_word(name: str, text: str) -> bool:
+    """`name`, metinde bir kelimenin BAŞINDA geçiyor mu? ("Konya'da" eşleşir, "olmuş" ≠ "Muş")."""
+    return re.search(r"(?<![0-9a-zçğıöşü])" + re.escape(name), text) is not None
+
+
+@dataclass
+class KnowledgeBase:
+    cards: dict[str, dict] = field(default_factory=dict)
+    variables: dict[str, dict] = field(default_factory=dict)
+    places: dict = field(default_factory=dict)
+
+    # ------------------------------------------------------------------ yükleme
+    @classmethod
+    def load(cls, kb_dir: Path | str = KB_DIR) -> "KnowledgeBase":
+        """kb/ klasöründeki tüm kartları okur."""
+        kb_dir = Path(kb_dir)
+        cards = {}
+        for f in sorted((kb_dir / "cards").glob("*.yaml")):
+            c = yaml.safe_load(f.read_text(encoding="utf-8"))
+            cards[c["id"]] = c
+        variables = {v["ad"]: v for v in
+                     yaml.safe_load((kb_dir / "degiskenler.yaml").read_text(encoding="utf-8"))}
+        places = yaml.safe_load((kb_dir / "yerler.yaml").read_text(encoding="utf-8"))
+        return cls(cards, variables, places)
+
+    # ------------------------------------------------------------------ yerler
+    def resolve_place(self, text: str, available: set[str] | None = None) -> dict:
+        """Metindeki yer adını analiz bölgesine çevirir.
+
+        Sıra: özel bölge (ör. Konya Ovası) -> il -> coğrafi bölge adı.
+        available: veri hattında gerçekten bulunan bölge kimlikleri (data/regions.py). Verilirse
+        önerilen bölge orada yoksa `missing=True` döner, böylece arayüz kullanıcıya söyler.
+        Dönen: {"region": id|None, "matched": "metindeki ad", "via": "ozel|il|bolge", "missing": bool}
+        """
+        q = tr_lower(text)
+        hit = None
+        for rid, r in self.places.get("ozel", {}).items():
+            if any(_starts_word(tr_lower(a), q) for a in r["takma_adlar"]):
+                hit = {"region": rid, "matched": r["ad"], "via": "ozel"}
+                break
+        if hit is None:
+            # Uzun adlar önce: "Kahramanmaraş" "Maraş"tan önce denenir.
+            pairs = [(il, rid) for rid, iller in self.places["iller"].items() for il in iller]
+            for il, rid in sorted(pairs, key=lambda p: -len(p[0])):
+                if _starts_word(tr_lower(il), q):
+                    special = self.places.get("il_ozel", {}).get(il)
+                    if special and (available is None or special in available):
+                        rid = special
+                    hit = {"region": rid, "matched": il, "via": "il"}
+                    break
+        if hit is None:
+            for rid, r in self.places["bolgeler"].items():
+                if any(_starts_word(tr_lower(a), q) for a in r["takma_adlar"]):
+                    hit = {"region": rid, "matched": r["ad"], "via": "bolge"}
+                    break
+        if hit is None:
+            return {"region": None, "matched": None, "via": None, "missing": False}
+        hit["missing"] = available is not None and hit["region"] not in available
+        return hit
+
+    def region_name(self, region_id: str) -> str:
+        """Bölge kimliğinin okunur adı."""
+        for group in ("ozel", "bolgeler"):
+            if region_id in self.places.get(group, {}):
+                return self.places[group][region_id]["ad"]
+        return region_id
+
+    # ------------------------------------------------------------------ eşleştirme (yedek)
+    def _strip_places(self, q: str) -> str:
+        """Yer adlarını sorudan çıkarır: "Karadeniz" içindeki "kar" kar kartını tetiklemesin."""
+        names = [a for g in ("ozel", "bolgeler") for r in self.places.get(g, {}).values()
+                 for a in r["takma_adlar"]]
+        names += [il for iller in self.places["iller"].values() for il in iller]
+        for n in sorted((tr_lower(x) for x in names), key=len, reverse=True):
+            q = re.sub(r"(?<![0-9a-zçğıöşü])" + re.escape(n) + r"[\w']*", " ", q)
+        return q
+
+    def match_card(self, text: str) -> str | None:
+        """Anahtar kelimeyle en uygun süreç kartı (LLM yokken/başarısızken yedek).
+
+        Puan = eşleşen kalıp sayısı; beraberlikte soruda İLK geçen konu kazanır
+        ("Doğu Anadolu'da kar ... ısınmayla tutarlı mı?" -> kar kartı)."""
+        q = self._strip_places(tr_lower(text))
+        best, best_key = None, (0, 0)
+        for cid, c in self.cards.items():
+            pos = [m.start() for k in c.get("soru_kaliplari", [])
+                   for m in [re.search(r"(?<![0-9a-zçğıöşü])" + re.escape(tr_lower(k)), q)] if m]
+            if pos:
+                key = (len(pos), -min(pos))
+                if key > best_key:
+                    best, best_key = cid, key
+        return best
+
+    def match_variable(self, text: str) -> str | None:
+        """Anahtar kelimeyle değişken (kartsız, tek değişkenli sorular için)."""
+        q = self._strip_places(tr_lower(text))
+        best, score = None, 0
+        for ad, v in self.variables.items():
+            s = sum(len(k) for k in v.get("anahtar_kelimeler", []) if tr_lower(k) in q)
+            if s > score:
+                best, score = ad, s
+        return best
+
+    # ------------------------------------------------------------------ LLM için özet
+    def catalog_for_prompt(self) -> str:
+        """Planlayıcı LLM'e verilen kısa katalog: kart ve değişken kimlikleri + açıklamaları."""
+        lines = ["SÜREÇ KARTLARI (card_id: başlık — örnek soru):"]
+        for cid, c in self.cards.items():
+            ex = (c.get("ornek_sorular") or [""])[0]
+            lines.append(f"- {cid}: {c['baslik']} — örn. \"{ex}\"")
+        lines.append("\nDEĞİŞKENLER (degisken: başlık):")
+        for ad, v in self.variables.items():
+            if ad != "rakim":
+                lines.append(f"- {ad}: {v['baslik']}")
+        return "\n".join(lines)
diff --git a/llm/plan.py b/llm/plan.py
